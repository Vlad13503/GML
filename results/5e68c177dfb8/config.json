{
  "datasets": [
    "email-Enron",
    "tags-ask-ubuntu"
  ],
  "seeds": [
    0,
    1,
    2
  ],
  "models": [
    "deepsets",
    "gcn",
    "allset",
    "allset_cpa",
    "allset_size"
  ],
  "experiments": [
    {
      "protocol": "random",
      "k": 3
    },
    {
      "protocol": "order",
      "k": 3
    },
    {
      "protocol": "interpolation",
      "k": 3,
      "interpolation_bounds": [
        2,
        5
      ]
    }
  ],
  "hidden_dim": 64,
  "layers": 2,
  "heads": 4,
  "dropout": 0.2,
  "learning_rates": [
    0.001,
    0.01
  ],
  "weight_decay": 0.0001,
  "epochs": 150,
  "patience": 30,
  "eval_every": 5,
  "batch_size": 2048,
  "threads": 4,
  "negative_ratio": 1,
  "hard_negative_fraction": 0.5,
  "context_fraction": 0.6,
  "min_partition_positives": 10,
  "probe_limit": 2000,
  "dataset_overrides": {
    "email-Enron": {
      "hidden_dim": 32,
      "layers": 1,
      "dropout": 0.2
    },
    "tags-ask-ubuntu": {
      "hidden_dim": 64,
      "layers": 2,
      "dropout": 0.0
    }
  }
}